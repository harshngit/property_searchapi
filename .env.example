PORT=5000
NODE_ENV=development

# Dev/test convenience: outside production, /api/auth/register accepts every
# role (including admin/super_admin), not just customer/broker. Leave unset
# to follow NODE_ENV; set explicitly to force on ("true") or off ("false").
# NEVER set to true in a real deployment.
# ALLOW_ALL_ROLE_REGISTRATION=true

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=propertysearch
DB_USER=postgres
DB_PASSWORD=postgres

# JWT
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# OTP
OTP_EXPIRY_MINUTES=5
OTP_LENGTH=6

# Password reset
RESET_TOKEN_EXPIRY_MINUTES=30

# AI Lead Qualification (Anthropic API)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# WhatsApp Integration (Meta Cloud API) - not yet wired to a real call, see
# whatsapp.service.js TODO comments
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
