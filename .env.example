PORT=5000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=propertysearch
DB_USER=postgres
DB_PASSWORD=postgres

# JWT
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# OTP
OTP_EXPIRY_MINUTES=5
OTP_LENGTH=6

# Password reset
RESET_TOKEN_EXPIRY_MINUTES=30

# Email (SMTP) - used for OTP/reset-link delivery and other platform emails
# once wired up (see the "integrate with SMS/Email provider" TODO comments
# in auth.service.js). SMTP_PORT 587 = STARTTLS -> SMTP_SECURE=false;
# port 465 (implicit TLS) would need SMTP_SECURE=true instead.
# SMTP_PASSWORD is a Gmail App Password (not the account password) - generate
# one at https://myaccount.google.com/apppasswords for info@propertyserch.com.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@propertyserch.com
SMTP_PASSWORD=your_gmail_app_password_here
SMTP_FROM_NAME=PropertySerch.com
SMTP_FROM_EMAIL=info@propertyserch.com

# Google Cloud Storage - property images/videos, documents, and user profile
# pictures. Files are stored at properties/<property-id>/images|videos/...
# and users/<user-id>/profile/...; Postgres stores only the object path.
# The bucket is PRIVATE (Public Access Prevention on) - reads go out as
# short-lived V4 signed URLs generated per-request by utils/storage.js, never
# a bare storage.googleapis.com URL. Auth uses Application Default
# Credentials - on Cloud Run this is the service account attached to the
# service (needs Storage Object Admin on the bucket, PLUS the
# "Service Account Token Creator" role granted to itself, since V4 signing
# without a key file goes through the IAM signBlob API - see the comment in
# utils/storage.js). Locally, run `gcloud auth application-default login`
# (that user account also needs signBlob rights, or you can point
# GOOGLE_APPLICATION_CREDENTIALS at a service account key file instead).
GCS_BUCKET_NAME=your_gcs_bucket_name
GCS_PROJECT_ID=your_gcp_project_id

# AI Lead Qualification (Anthropic API)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# WhatsApp Integration (Meta Cloud API) - not yet wired to a real call, see
# whatsapp.service.js TODO comments
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here

# SMS OTP Delivery (MSG91) - delivers the OTP generated in
# auth.service.js::createOtp() over SMS whenever the identifier is a mobile
# number (email identifiers aren't delivered yet). If left unset for a given
# purpose, OTP send for that purpose still works in development via the
# debug OTP echoed back in the API response (see auth.controller.js), but is
# a hard error in production.
# MSG91_AUTH_KEY: MSG91 dashboard -> top-right "AuthKey" link.
# Each otp_purpose (register/login/reset_password/mobile_verification) needs
# its own DLT-approved template - MSG91 dashboard -> SendOTP > Templates ->
# "+ Add Template" (a template only gets a usable id here once added to the
# SendOTP module, even if already DLT-approved elsewhere). Each template's
# body must include the ##OTP## variable, since msg91.service.js passes our
# own already-generated code via the `otp` param rather than letting MSG91
# generate one. Only fill in the purposes you actually use OTP for - leave
# the rest blank.
# MSG91_SEND_MODE: "otp" (default) calls MSG91's dedicated OTP API - use
# this if your templates use the ##OTP## variable. Set to "flow" to instead
# call MSG91's general Send SMS / Flow API (msg91.service.js) - only needed
# if your MSG91 account is actually provisioned for that product instead.
# NOTE: this is a template file committed to git - never put a real key or
# template id here, only in your local (gitignored) .env.
MSG91_SEND_MODE=otp
MSG91_AUTH_KEY=your_msg91_authkey_here
MSG91_OTP_TEMPLATE_ID_REGISTER=your_register_template_id_here
MSG91_OTP_TEMPLATE_ID_LOGIN=your_login_template_id_here
MSG91_OTP_TEMPLATE_ID_RESET_PASSWORD=your_reset_password_template_id_here
MSG91_OTP_TEMPLATE_ID_MOBILE_VERIFICATION=your_mobile_verification_template_id_here
MSG91_COUNTRY_CODE=91
